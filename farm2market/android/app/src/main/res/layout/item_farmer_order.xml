<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="#ABC12345"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="@dimen/text_size_sm"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCustomer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Customer Name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_md" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 Jan, 12:00 PM"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_sm" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvItems"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3 items"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_md" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReject"
                style="@style/Widget.Farm2Market.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="Reject"
                android:textColor="@color/error"
                android:textSize="@dimen/text_size_sm"
                android:visibility="gone"
                app:strokeColor="@color/error" />

            <Button
                android:id="@+id/btnAccept"
                style="@style/Widget.Farm2Market.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Accept"
                android:textSize="@dimen/text_size_sm"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnPreparing"
                style="@style/Widget.Farm2Market.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Start Preparing"
                android:textSize="@dimen/text_size_sm"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnReady"
                style="@style/Widget.Farm2Market.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Mark Ready"
                android:textSize="@dimen/text_size_sm"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
